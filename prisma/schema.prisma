// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MaterialRole {
  MAIN_MATERIAL       // Material Teórico Âncora (ex: CFC) - entra no scheduler e na complitude
  REFERENCE_MATERIAL  // Material Teórico de Referência (ex: Estratégia) - NÃO entra no scheduler diário de teoria, MAS ENTRA na complitude se concluído
  SUPPORT_MATERIAL    // Material de Apoio (Resumos, Questões, Leis) - NÃO entra no scheduler de teoria e NÃO entra na complitude principal
  MIXED_MATERIAL      // Material Misto (Histórico)
  UNKNOWN             // Não classificado
}

// ⚠️ REGRA DE CONSUMO DE MATERIAL_ROLE:
// 1. scheduler.ts (Agendamento de leitura THEORY): Exclui SUPPORT_MATERIAL E REFERENCE_MATERIAL (para evitar agendamento duplo).
// 2. subject-metrics.ts e completion.ts (Complitude do edital): Exclui APENAS SUPPORT_MATERIAL (preservando blocos concluídos de referência na complitude).

// ── Hybrid 80/20 ──────────────────────────────────────────────────────────────
enum StudyMaterialProvider {
  CFC // Concurseiro Fora da Caixa (âncora 80/20)
  ESTRATEGIA // Estratégia Concursos (aprofundamento)
  OTHER // Demais fornecedores (default para material histórico)
}

enum StudyBlockMethodology {
  LINEAR
  ANCHOR_BASED
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  passwordHash           String?
  authUserId             String?   @unique
  lastLoginAt            DateTime?
  googleAccountConnected Boolean   @default(false)
  googleAccessToken      String?
  googleRefreshToken     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  preferences UserPreferences?

  subjects             StudySubject[]
  studyPlans           StudyPlan[]
  flashcards           Flashcard[]
  materials            StudyMaterial[]
  extractedContent     ExtractedContent[]
  studyBlocks          StudyBlock[]
  studySchedules       StudySchedule[]
  studyScheduleItems   StudyScheduleItem[]
  studySessionLogs     StudySessionLog[]
  questionReviewTasks  QuestionReviewTask[]
  weeklyReviewSessions WeeklyReviewSession[]
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyGoalMinutes            Int                        @default(120)
  studyResetTime              String                     @default("00:00")
  studyDaysOfWeek             String                     @default("1,2,3,4,5")
  defaultBlockDurationMinutes Int                        @default(30)
  maxNewCardsPerDay           Int                        @default(20)
  flashcardDifficulty         String                     @default("NORMAL_PLUS")
  emailReminderEnabled        Boolean                    @default(true)
  emailReminderTime           String                     @default("08:00")
  dailyReminderEmail          String?
  lastDailyReminderSentAt     DateTime?
  visualDensity               String                     @default("comfortable")
  reducedMotion               Boolean                    @default(false)
  focusArea                   String                     @default("Geral")
  theme                       String                     @default("light")
  displayName                 String                     @default("Estudante")
  examGoal                    String                     @default("TRT4")
  deadline                    DateTime?
  avatarUrl                   String?
  languageTone                String                     @default("MASCULINE_NEUTRAL")
  scheduleGenerationMode      String?                    @default("DYNAMIC")
  weeklyReviewEnabled         Boolean                    @default(false)
  weeklyReviewDayOfWeek       Int                        @default(0)
  weeklyReviewMissedBehavior  WeeklyReviewMissedBehavior @default(MOVE_TO_NEXT_AVAILABLE_DAY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySubject {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  priority            Int                  @default(1)
  examWeight          Float                @default(1.0)
  progress            Float                @default(0)
  studyPriority       String               @default("PRIMARY")
  schedulingStatus    SchedulingStatus     @default(ACTIVE)
  deferredUntil       DateTime?
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  materials           StudyMaterial[]
  flashcards          Flashcard[]
  studyPlanDays       StudyPlanDay[]
  extractedContent    ExtractedContent[]
  studyBlocks         StudyBlock[]
  schedules           StudySchedule[]
  scheduleItems       StudyScheduleItem[]
  questionReviewTasks QuestionReviewTask[]
  weeklyReviewTopics  WeeklyReviewTopic[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

enum SchedulingStatus {
  ACTIVE
  DEFERRED
  ARCHIVED
}

model StudyMaterial {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id])
  fileName          String
  originalFileName  String?
  filePath          String?
  googleDriveFileId String?
  mimeType          String  @default("application/pdf")
  fileSize          Int?
  totalPages        Int?

  // New fields for the intelligent organizer
  sourceType          String  @default("LOCAL_UPLOAD") // LOCAL_UPLOAD, LOCAL_INBOX
  sourcePath          String?
  fileHash            String?
  organizationStatus  String  @default("UPLOADED") // UPLOADED, IMPORTED, EXTRACTING, ANALYZING, ORGANIZED, NEEDS_REVIEW, ERROR
  detectedSubjectName String?
  detectedStructure   String? // JSON string for structure

  processingStatus   String              @default("PENDING") // PENDING, PROCESSING, PROCESSED, ERROR
  processingError    String?
  subjectId          String?
  subject            StudySubject?       @relation(fields: [subjectId], references: [id])
  materialRole       MaterialRole        @default(UNKNOWN)
  supportForTopicId  String?
  supportedBlocks    StudyBlockSupport[]
  extractedContent   ExtractedContent[]
  studyBlocks        StudyBlock[]
  flashcards         Flashcard[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  studyScheduleItems StudyScheduleItem[]

  provider           StudyMaterialProvider @default(OTHER)
}

model ExtractedContent {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id])
  subjectId             String
  subject               StudySubject   @relation(fields: [subjectId], references: [id])
  title                 String?
  pageNumber            Int
  text                  String
  orderIndex            Int
  estimatedStudyMinutes Int?
  materialId            String
  material              StudyMaterial  @relation(fields: [materialId], references: [id])
  studyPlanDays         StudyPlanDay[]
  flashcards            Flashcard[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model StudyPlan {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  estimatedExamDate DateTime?
  dailyStudyMinutes Int            @default(120)
  availableWeekDays String         @default("1,2,3,4,5") // 0=Sun, 1=Mon, etc.
  status            String         @default("ACTIVE")
  days              StudyPlanDay[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model StudyPlanDay {
  id            String           @id @default(cuid())
  studyPlanId   String
  studyPlan     StudyPlan        @relation(fields: [studyPlanId], references: [id])
  dayNumber     Int
  scheduledDate DateTime
  subjectId     String
  subject       StudySubject     @relation(fields: [subjectId], references: [id])
  contentId     String
  content       ExtractedContent @relation(fields: [contentId], references: [id])
  status        String           @default("PENDING") // PENDING, COMPLETED, SKIPPED
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Flashcard {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  subjectId    String
  subject      StudySubject      @relation(fields: [subjectId], references: [id])
  contentId    String?
  content      ExtractedContent? @relation(fields: [contentId], references: [id])
  materialId   String?
  material     StudyMaterial?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  studyBlockId String?
  studyBlock   StudyBlock?       @relation(fields: [studyBlockId], references: [id], onDelete: SetNull)

  question   String
  answer     String
  type       String @default("QUESTION_ANSWER") // QUESTION_ANSWER, CLOZE
  difficulty String @default("MEDIUM") // EASY, MEDIUM, HARD
  status     String @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, ARCHIVED

  // SRS (Anki-style)
  reviewState     String?   @default("NEW") // NEW, LEARNING, REVIEW, RELEARNING, SUSPENDED
  learningStep    Int?      @default(0)
  easeFactor      Float?    @default(2.5)
  intervalDays    Int?      @default(0)
  repetitionCount Int?      @default(0)
  lapseCount      Int?      @default(0)
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime? @default(now())
  approvedAt      DateTime?

  sourcePageStart Int?
  sourcePageEnd   Int?

  // ── Hybrid 80/20 ──────────────────────────────────────────────────────────
  // Geração do card: MANUAL, LINEAR_AI, HYBRID_AI
  // Para cards híbridos, sourceMaterialId preserva a origem real (CFC ou Estratégia)
  generationReason String? @db.Text

  reviews   FlashcardReview[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, nextReviewAt])
  @@index([userId, reviewState])
}

model FlashcardReview {
  id          String    @id @default(cuid())
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId      String
  rating      Int // 1=Again, 2=Hard, 3=Good, 4=Easy
  reviewedAt  DateTime  @default(now())

  previousState        String
  newState             String
  previousInterval     Int
  newInterval          Int
  previousEaseFactor   Float
  newEaseFactor        Float
  previousNextReviewAt DateTime
  newNextReviewAt      DateTime
}

model StudyNote {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyBlock {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  subjectId  String
  subject    StudySubject  @relation(fields: [subjectId], references: [id])
  materialId String
  material   StudyMaterial @relation(fields: [materialId], references: [id])

  title                 String
  description           String?
  pageStart             Int
  pageEnd               Int
  orderIndex            Int     @default(0)
  estimatedStudyMinutes Int?

  // AI organization metadata
  createdBy         String  @default("MANUAL") // MANUAL, AI
  sourceHeading     String?
  sourceSection     String?
  officialTopicId   String?
  officialTopicName String?
  topicCode         String?
  needsManualReview Boolean   @default(false)
  confidence        Float?

  // Study cycle lifecycle
  theoryStatus     String @default("NOT_STARTED") // NOT_STARTED | COMPLETED
  questionsStatus  String @default("NOT_STARTED") // NOT_STARTED | COMPLETED
  flashcardsStatus String @default("NOT_STARTED") // NOT_STARTED | GENERATED

  theoryCompletedAt     DateTime?
  questionsCompletedAt  DateTime?
  flashcardsGeneratedAt DateTime?

  // Spaced repetition block reviews
  review1dScheduledAt  DateTime?
  review7dScheduledAt  DateTime?
  review15dScheduledAt DateTime?
  review30dScheduledAt DateTime?

  review1dCompletedAt  DateTime?
  review7dCompletedAt  DateTime?
  review15dCompletedAt DateTime?
  review30dCompletedAt DateTime?

  lastStudiedAt  DateTime?
  nextActionType String? // THEORY | QUESTIONS | GENERATE_FLASHCARDS | REVIEW_BLOCK | REINFORCEMENT
  nextActionAt   DateTime?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  flashcards               Flashcard[]
  scheduleItems            StudyScheduleItem[]
  supportMaterials         StudyBlockSupport[]
  studySessionLogs         StudySessionLog[]
  questionReviewTask       QuestionReviewTask?
  weeklyReviewTopicSources WeeklyReviewTopicSource[]

  methodology     StudyBlockMethodology @default(LINEAR)
  generationRunId String?               @unique

  @@index([userId, theoryStatus])
  @@index([methodology])
}

model StudyBlockSupport {
  id           String        @id @default(cuid())
  studyBlockId String
  studyBlock   StudyBlock    @relation(fields: [studyBlockId], references: [id], onDelete: Cascade)
  materialId   String
  material     StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pageStart    Int?
  pageEnd      Int?
  supportType  String? // BIZU, MAPA_MENTAL, RESUMO, REVISAO, QUESTOES
  confidence   Float?
  createdAt    DateTime      @default(now())
}

model StudySchedule {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  title             String
  startDate         DateTime            @default(now())
  estimatedExamDate DateTime?
  dailyStudyMinutes Int                 @default(60)
  status            String              @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  items             StudyScheduleItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  studySubject      StudySubject?       @relation(fields: [studySubjectId], references: [id])
  studySubjectId    String?
}

model StudyScheduleItem {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  scheduleId   String
  schedule     StudySchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      StudySubject   @relation(fields: [subjectId], references: [id])
  materialId   String?
  material     StudyMaterial? @relation(fields: [materialId], references: [id])
  studyBlockId String?
  studyBlock   StudyBlock?    @relation(fields: [studyBlockId], references: [id], onDelete: Cascade)

  // Action metadata (new)
  actionType    String? // THEORY | QUESTIONS | GENERATE_FLASHCARDS | REVIEW_BLOCK | REVIEW_FLASHCARDS | REINFORCEMENT
  priorityScore Float?
  reason        String?

  dayNumber             Int
  scheduledDate         DateTime?
  estimatedMinutes      Int?
  startedAt             DateTime?
  completedAt           DateTime?
  actualDurationMinutes Int?
  status                String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  studySessionLogs StudySessionLog[]

  @@index([userId, scheduledDate, status])
  @@index([userId, scheduleId, status])
}

enum StudySessionActionType {
  THEORY
  SECOND_PASS
  REINFORCEMENT
  EXTRA_STUDY
  REVIEW_BLOCK
  REVIEW_FLASHCARDS
}

enum StudySessionSource {
  TIMER
  MANUAL
  SYSTEM
}

model StudySessionLog {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyBlockId        String?
  studyBlock          StudyBlock?        @relation(fields: [studyBlockId], references: [id], onDelete: Cascade)
  studyScheduleItemId String?
  studyScheduleItem   StudyScheduleItem? @relation(fields: [studyScheduleItemId], references: [id], onDelete: SetNull)

  actionType      StudySessionActionType
  durationMinutes Int
  startedAt       DateTime?
  completedAt     DateTime?
  studiedAt       DateTime               @default(now())
  source          StudySessionSource     @default(TIMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, studiedAt])
  @@index([userId, studyBlockId])
}

// ═══ REVISÃO POR QUESTÕES (independente do cronograma principal) ═══

enum QuestionReviewStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum QuestionReviewOrigin {
  AUTOMATIC
  BACKFILL
}

model QuestionReviewTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Referência opcional com onDelete: SetNull para preservação histórica
  studyBlockId String?      @unique
  studyBlock   StudyBlock?  @relation(fields: [studyBlockId], references: [id], onDelete: SetNull)
  subjectId    String
  subject      StudySubject @relation(fields: [subjectId], references: [id])

  // Snapshots para integridade histórica se o bloco for excluído
  sourceBlockTitle   String
  sourceMaterialName String?
  sourcePageStart    Int?
  sourcePageEnd      Int?
  sourceSubjectName  String

  // Configurações e links
  questionBankUrl          String?
  recommendedQuestionCount Int     @default(15)

  // Datas
  sourceStudyDate DateTime // Data em que o bloco de teoria foi concluído
  scheduledDate   DateTime // Data agendada para revisão (D+15 com overflow)

  // Status e Métricas
  status             QuestionReviewStatus @default(PENDING)
  completedAt        DateTime?
  questionsAttempted Int?
  correctCount       Int?
  wrongCount         Int?

  // Mapeamento CFC (Manual)
  cfcPdfName   String?
  cfcStartPage Int?
  cfcEndPage   Int?
  cfcTopic     String?
  cfcNotes     String?

  notes  String?
  origin QuestionReviewOrigin @default(AUTOMATIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledDate, status])
  @@index([userId, subjectId, status])
}

enum WeeklyReviewMissedBehavior {
  MOVE_TO_NEXT_AVAILABLE_DAY
  SKIP_CURRENT_WEEK
}

enum WeeklyReviewSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum WeeklyReviewSelectionReason {
  WEEK_CONTENT
  OVERDUE
  LONG_UNSEEN
}

enum WeeklyReviewTopicResult {
  PENDING
  DID_WELL
  HAD_DOUBTS
  REVIEW_AGAIN
}

model WeeklyReviewSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalScheduledDate  DateTime @db.Date
  effectiveScheduledDate DateTime @db.Date

  sourcePeriodStart DateTime @db.Date
  sourcePeriodEnd   DateTime @db.Date

  status         WeeklyReviewSessionStatus  @default(PENDING)
  missedBehavior WeeklyReviewMissedBehavior

  availableMinutes       Int?
  suggestedQuestionCount Int?
  targetQuestionCount    Int?
  actualQuestionCount    Int?

  startedAt   DateTime?
  completedAt DateTime?
  skippedAt   DateTime?

  topics WeeklyReviewTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, originalScheduledDate])
  @@index([userId, effectiveScheduledDate, status])
}

model WeeklyReviewTopic {
  id                    String              @id @default(cuid())
  weeklyReviewSessionId String
  weeklyReviewSession   WeeklyReviewSession @relation(fields: [weeklyReviewSessionId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  sourceSubjectName String
  displayTitle      String
  groupKey          String

  carriedFromTopicId String?
  carriedFromTopic   WeeklyReviewTopic?  @relation("WeeklyReviewTopicCarryover", fields: [carriedFromTopicId], references: [id], onDelete: SetNull)
  carriedTopics      WeeklyReviewTopic[] @relation("WeeklyReviewTopicCarryover")

  priorityRank       Int?
  suggestedQuestions Int?

  selectionReason  WeeklyReviewSelectionReason
  result           WeeklyReviewTopicResult     @default(PENDING)
  resultRecordedAt DateTime?
  notes            String?

  sources WeeklyReviewTopicSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weeklyReviewSessionId, groupKey])
  @@index([weeklyReviewSessionId, selectionReason, result])
  @@index([carriedFromTopicId])
}

model WeeklyReviewTopicSource {
  id                  String            @id @default(cuid())
  weeklyReviewTopicId String
  weeklyReviewTopic   WeeklyReviewTopic @relation(fields: [weeklyReviewTopicId], references: [id], onDelete: Cascade)

  studyBlockId String?
  studyBlock   StudyBlock? @relation(fields: [studyBlockId], references: [id], onDelete: SetNull)

  sourceBlockTitle   String // Snapshot do título do bloco
  sourceMaterialName String? // Snapshot do nome do material (PDF)
  sourcePageStart    Int?
  sourcePageEnd      Int?
  sourceStudyDate    DateTime // Data em que a teoria foi concluída

  createdAt DateTime @default(now())

  @@unique([weeklyReviewTopicId, studyBlockId])
  @@index([weeklyReviewTopicId])
  @@index([studyBlockId])
}

// ═══ VERSIONAMENTO DE TAXONOMIA DO EDITAL ═══
// Permite manter múltiplas versões de taxonomia convivendo no banco.
// - Versão ativa: usada pelo scheduler e métricas (apenas uma por vez, via índice parcial).
// - Versões inativas: para inspeção, comparação cross-version, e preparação do F4.
// - Regra de IDs de SyllabusTopic:
//     • PRIMEIRA versão (ESTRATEGIA_COURSE_GRID) mantém IDs legados (e.g. "const_t1")
//     • Versões futuras usam IDs prefixados (e.g. "trt4_2026p__const_t1")
//     • @@unique([versionId, topicCode]) garante integridade DENTRO de cada versão

model SyllabusVersion {
  id          String @id
  label       String @unique // e.g. "ESTRATEGIA_COURSE_GRID", "TRT4_2026_PROJETADO"
  source      String         // Origem da taxonomia (nome do curso, edital, etc.)
  description String?
  isActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects SyllabusSubject[]
  topics   SyllabusTopic[]

  // Garante que no máximo UMA versão esteja ativa no banco
  @@unique([isActive], name: "SyllabusVersion_single_active", map: "SyllabusVersion_single_active")
}

// Camada intermediária: representa uma MATÉRIA dentro de uma versão específica.
// Guarda atributos que são por-matéria (não por-tópico): questoesDaMateria, blocoConhecimento, weight.
// Evita redundância de repetir "30 questões" em cada um dos 20 tópicos de Processual do Trabalho.
model SyllabusSubject {
  id                String          @id @default(cuid())
  versionId         String
  version           SyllabusVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  canonicalKey      String          // e.g. DIREITO_CONSTITUCIONAL, RACIOCINIO_LOGICO_MATEMATICO
  displayName       String          // Nome de exibição: "Direito Constitucional"
  blocoConhecimento String          // "ESPECIFICOS" | "GERAIS"
  questoesDaMateria Int?            // Número de questões do bloco de conhecimento (30 para TRT4 AJAJ). NULL para versões sem dado de edital.
  weight            Float           @default(1.0) // Peso padrão da matéria nesta versão (2.0 para Específicos, 1.0 para Gerais)
  orderIndex        Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, canonicalKey])
}

model SyllabusTopic {
  id                  String          @id
  versionId           String
  version             SyllabusVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subjectCanonicalKey String          // Chave canônica da matéria (vínculo implícito com SyllabusSubject via versionId + canonicalKey)
  subjectName         String          // Nome legível da matéria (denormalizado para conveniência)
  topicCode           String          // e.g. "Tópico 01" (único dentro da versão+matéria)
  title               String
  normalizedTitle     String          // Título normalizado para comparação fuzzy
  orderIndex          Int
  weight              Float           @default(1.0) // Peso individual do tópico (herda do SyllabusSubject por padrão, pode ser sobrescrito)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, topicCode])
  @@index([versionId])
  @@index([subjectCanonicalKey])
}
